{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Argos",
  "version": "0.1.0",
  "identifier": "app.argos.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [{"label":"main","title":"Argos","width":720,"height":550,"minWidth":320,"minHeight":200,"transparent":true,"contentProtected":true}],
    "security": { "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost", "capabilities": ["capture"] }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
